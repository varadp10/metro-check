# Copy this file to ".env" in the same folder and fill in values as needed.
# Nothing here is required to run the app locally — it works with zero
# configuration in "local" mode.

# ---- Storage mode ----
# local     = SQLite + local folder (default, zero setup, use this first)
# supabase  = Supabase cloud database + storage ("production" mode)
STORAGE_MODE=local

# ---- Only needed if STORAGE_MODE=supabase ----
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Optional AI cross-check ----
# true/false. If true, requires ANTHROPIC_API_KEY below.
USE_AI_CROSSCHECK=false
ANTHROPIC_API_KEY=
